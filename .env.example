
# Let linux runs persist between host and container (unset: 1000)
HOST_UID=1000 # (`id -u`)
HOST_GID=1000 # (`id -g`)

# Credentials
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# for an OpenAI-compatible server endpoint (e.g. vLLM)
OAI_API_BASE_URL=http://host.docker.internal:8000/v1 # host
OAI_API_KEY=EMPTY

# Optionally supply a Qdrant server, else local index
# QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=
