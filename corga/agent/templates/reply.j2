{# The factual part of every reply, in reading order. Each section opens with a blank line and renders only when
   the result has something to show; a result whose kind has no such field skips the section. #}
{% macro forecast_table(label, hours) %}

**Forecast ({{ label }})**

| Hour | Rain (mm) | Conditions | °C |
|---|---|---|---|
{% for h in hours %}
| {{ h.time | weekday_hour }} | {{ h.precipitation_mm }} | {{ h.description }} | {{ h.temperature_c }} |
{% endfor %}
{% endmacro %}
{% macro preferences_in_words(p) %}
  {%- set sep = joiner("; ") -%}
  {%- if p.interests %}{{ sep() }}interests {{ p.interests | join(", ") }}{% endif -%}
  {%- if p.with_child %}{{ sep() }}with a child{% endif -%}
  {%- if p.avoid_museums %}{{ sep() }}no museums{% endif -%}
  {%- if p.setting %}{{ sep() }}{{ p.setting }} places{% endif -%}
  {%- if not (p.interests or p.with_child or p.avoid_museums or p.setting) %}none{% endif -%}
{% endmacro %}
{% if result.feasibility is defined and result.feasibility and not result.feasibility.feasible %}

**Why this does not fit:**
{% for issue in result.feasibility.issues %}
- {{ issue.message }}
{% endfor %}
{% if result.feasibility.alternative %}

**Closest feasible alternative:**
{% endif %}
{% endif %}
{% if result.itinerary is defined and result.itinerary %}
{% set itinerary = result.itinerary %}

**Itinerary: {{ itinerary.window.start | day }}, {{ itinerary.window.start | hhmm }}–{{ itinerary.window.end | hhmm }}**

| # | Stop | Walk | Arrive | Visit | Setting |
|---|---|---|---|---|---|
{% for s in itinerary.stops %}
{% set walk = "–" if loop.first else s.walk_minutes ~ " min" %}
{% set arrive, visit = s.arrive | hhmm, (s.start | hhmm) ~ "–" ~ (s.end | hhmm) %}
| {{ loop.index }} | {{ s.name }} ({{ s.poi_id }}) | {{ walk }} | {{ arrive }} | {{ visit }} | {{ s.setting }} |
{% endfor %}
{% if itinerary.assumptions %}

*Assumptions:*
{% for assumption in itinerary.assumptions %}
- {{ assumption }}
{% endfor %}
{% endif %}
{% endif %}
{% if result.validation is defined and result.validation and result.validation.violations %}

**Checks:**
{% for v in result.validation.violations %}
- [{{ v.severity }}] {{ v.message }}
{% endfor %}
{% endif %}
{% if result.forecast is defined and result.forecast %}
{{ forecast_table(result.forecast.label, result.forecast.hours) }}
{% endif %}
{% if result.kind == "preferences" %}

**Preferences kept for the plan:** {{ preferences_in_words(result.preferences) }}
{%- endif %}
{% if result.kind == "answer" %}
{{ result.answer }}
{% endif %}
{% if result.citations is defined and result.citations %}

**Sources (dataset records):**
